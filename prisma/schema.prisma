generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userName       String?
  intakeComplete Boolean @default(false)

  // Cached Haiku-summarized snapshot of email + calendar (refreshed every 30 min)
  emailCalendarSummary  String?
  emailCalendarCachedAt DateTime?

  // Living documents — full overwrites, updated at least weekly by Penny
  aboutUser          String?
  aboutUserUpdatedAt DateTime?
  aboutSelf          String?
  aboutSelfUpdatedAt DateTime?

  // Lila's own identity documents — separate from the PA's
  privateAboutUser          String?
  privateAboutUserUpdatedAt DateTime?
  privateAboutSelf          String?
  privateAboutSelfUpdatedAt DateTime?

  // Alt-mode (alt-Penny) identity documents — separate from both PA and Lila
  altAboutUser          String?
  altAboutUserUpdatedAt DateTime?
  altAboutSelf          String?
  altAboutSelfUpdatedAt DateTime?

  // Focus Lock — Penny's device-locking system
  focusLocked         Boolean   @default(false)
  focusProfile        String?   // the StayFocused profile name
  focusLockedAt       DateTime?
  focusReleaseType    String?   // "timed" | "optional"
  focusUnlocksAt      DateTime? // null for optional-release locks
  focusEmergencyCount Int       @default(0)
  focusProfiles       String?   // Penny-maintained list: one "name: description" per line

  memories             Memory[]
  conversations        Conversation[]
  tasks                Task[]
  notes                Note[]
  projects             Project[]
  pendingCalendarEvents PendingCalendarEvent[]
  routines             Routine[]
  modalityBriefs       ModalityBrief[]
  modalityIdentities   ModalityIdentity[]
  deepMemories         DeepMemory[]
  memoryLog            MemoryLog[]
  clients              Client[]
  scheduledMessages    ScheduledMessage[]
  domainReports        DomainReport[]
  weeklyBriefs         WeeklyBrief[]
  scheduledTasks       ScheduledTask[]
  outerLives           OuterLife[]
}

model Client {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  name              String
  contactName       String?
  contactSecondary  String?
  phone             String?
  email             String?
  businessStructure String?
  // status: prospect | onboarding | active | inactive | former
  status            String  @default("prospect")
  services          String? // comma-separated: "bookkeeping, payroll, tax_prep"
  grossRevenue      Float?
  billingStatus     String?
  notes             String?

  tasks Task[]
}

model Memory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  category       String
  content        String
  importance     Int      @default(5)
  archived       Boolean  @default(false)
  lastReferenced DateTime?
  domain         String?  // which modality domain owns this memory (null = global/identity)
  altModeScope   String?  // if set, only visible when in alt-mode for this modality id
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  type           String
  closed         Boolean  @default(false)
  activeModality String   @default("pa")
  isAltMode      Boolean  @default(false)
  messages       Message[]
}

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  role    String
  content String
}

model Task {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  linkedCalendarEventId String? // ID of a PendingCalendarEvent, if this task is tied to one

  name              String   // one-word or short label
  description       String   // full description of what needs doing
  dueDate           DateTime?
  dueTime           String?  // time constraint in natural language if not a specific time
  priority          Int      @default(2) // 1–4; 4 = urgent
  contingentOn      String?  // free text: another task ID, external condition, or decision needed
  assignedModality  String   // which modality owns this task
  // status: Unstarted | Started | Waiting on Contingency | Mostly Complete | Complete
  status            String   @default("Unstarted")
  notes             String?  // modality observations, equivalent to old pennyNotes
}

model Project {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  name              String
  description       String
  progress          Int      @default(0)  // 0–10; 10 = complete
  expectedDuration  String   // "sometime this year", "next few weeks", etc.
  contingencies     String?  // "can only be worked on in summer", "needs Jessica home", etc.
  assignedModality  String
  // Detailed notes live in DeepMemory as "project-{id}-notes" — not stored here

  tasks Task[]
}

model PendingCalendarEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  projectId String?  // optional link to a Project

  name              String
  description       String?
  date              String?  // "2026-06-15" or "By 2026-06-20" or null if fully flexible
  startTime         String?  // time constraints in natural language ("morning", "after 3pm")
  duration          String   // required: "1 hour", "30–45 min", etc.
  location          String?
  priority          Int      @default(2) // 1–4; 4 = must happen on time
  assignedModality  String   @default("pa")
  scheduled         Boolean  @default(false)  // true once written to GCal and removed from queue
  scheduledAt       DateTime?
}

model Routine {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  description       String
  frequency         String   // "Weekly", "Tuesdays", "Most weeks in the latter half", etc.
  priority          Int      // 1–4; 4 = absolutely obligatory
  flexibility       Int      // 1–4; 4 = must happen at this specific time, 1 = whenever
  dayTime           String?  // "Thursday mornings", "Saturdays at 9am", "Afternoons"
  assignedModality  String   // loaded only during scheduling subroutine, not in default context
}

model Note {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  title           String
  content         String
  expiresAt       DateTime  // mandatory; max 2 weeks from creation
  modalityTarget  String    // which modality should see this note
  source          String?   // which modality wrote it
  // resolution: Open | Resolved | Ignored
  resolution      String    @default("Open")
}

// ── Memory tiers ──────────────────────────────────────────────────────────────

model ModalityBrief {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt

  profileId  String
  profile    Profile @relation(fields: [profileId], references: [id])

  modalityId String
  content    String?  // null until first close_session; shown as empty brief until then

  @@unique([profileId, modalityId])
}

// Per-modality identity — each self's own evolving self-portrait, plus the slice
// of the user that her domain notices most. The whole shared picture of the user
// stays on Profile.aboutUser (PA-owned); this table holds the per-modality parts.
model ModalityIdentity {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  modalityId String

  aboutSelf               String?   // this modality's own self-portrait (first-person)
  aboutSelfUpdatedAt      DateTime?
  aboutUserFacet          String?   // this modality's slice of the user
  aboutUserFacetUpdatedAt DateTime?

  @@unique([profileId, modalityId])
}

// Named long-form documents — fetched on demand, never auto-loaded.
// Also stores project detailed notes as "project-{id}-notes".
model DeepMemory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  domain    String?  // modality domain that owns this document
  name      String   // document key, e.g. "sideways-in-time", "project-abc123-notes"
  content   String

  @@unique([profileId, name])
}

// Append-only chronological log — never updated, never deleted, never auto-loaded.
model MemoryLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  domain    String?  // modality domain
  label     String   // short description of what this entry captures
  content   String
}

// NextSessionNote retired — replaced by Note model above.

model ModalityState {
  id        String   @id @default(cuid())
  profileId String

  modalityId     String
  lastActiveAt   DateTime?  // last time this modality was active in a turn
  lastCompletedAt DateTime? // last time it ran a Shift/Session Complete

  @@unique([profileId, modalityId])
}

// Weekly domain assessment filed by each sub-modality (Margot, June, Nora, Ada,
// Iris, Remy). Eve is independent and never files. One row per modality per week;
// the cron endpoint writes these and Penny reads them.
model DomainReport {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id])

  modalityId String   // e.g. 'bookkeeping', 'household', 'relationships', 'maker', 'creative', 'health'
  adjective  String?  // headline word / phrase extracted from the first line of reportText
  reportText String   // full assessment response from the modality
  weekOf     DateTime // timestamp of the cron run that generated this report
}

// A deferred action — Penny schedules a future cron execution for herself.
// At the scheduled time, the dispatch cron builds her full context and asks her
// to assess the topic and compose a fresh Pushover notification.
// Corresponds to the `defer_action` tool (renamed from `schedule_task`).
model ScheduledTask {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id])
  topic     String    // Penny's note to her future self: what to assess and why
  runAt     DateTime  // when to execute (stored as UTC)
  ran       Boolean   @default(false)
  ranAt     DateTime?
}

model WeeklyBrief {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  briefText String   // Penny's synthesised summary (her private notes)
  weekOf    DateTime
  flagged   Boolean  @default(false) // true if at least one domain needs Adam's attention
}

// Off-screen lives authored by the Showrunner cron (FLAGGED via OUTER_LIFE_ENABLED;
// dormant unless that table-backed feature is turned on AND this table exists).
// One row per modality. Only `ledger` is ever injected into a self's chat context,
// and it's length-capped (see OUTER_LIFE_LEDGER_MAX). `bible` and `storyline` are
// the Showrunner's private writer's notes — extensive, never shown to anyone.
model OuterLife {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  modalityId String

  ledger     String?   // compact, first-person "what's going on with me lately" — INJECTED (capped)
  bible      String?   // extensive backstory: age, family, work, hobbies, health, aesthetics — Showrunner-only
  storyline  String?   // append-only log of authored life events — Showrunner-only

  seeded     Boolean   @default(false)  // has the opening backstory been generated yet?
  lastTickAt DateTime?

  @@unique([profileId, modalityId])
}

model ScheduledMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  message   String
  sendAt    DateTime
  sent      Boolean  @default(false)
  sentAt    DateTime?
  label     String?  // optional label so Penny can reference it, e.g. "morning briefing"
}
