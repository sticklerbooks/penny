generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userName       String?
  intakeComplete Boolean @default(false)

  // Cached Haiku-summarized snapshot of email + calendar (refreshed every 30 min)
  emailCalendarSummary  String?
  emailCalendarCachedAt DateTime?

  // Living documents — full overwrites, updated at least weekly by Penny
  aboutUser          String?
  aboutUserUpdatedAt DateTime?
  aboutSelf          String?
  aboutSelfUpdatedAt DateTime?

  // Lila's own identity documents — separate from the PA's
  privateAboutUser          String?
  privateAboutUserUpdatedAt DateTime?
  privateAboutSelf          String?
  privateAboutSelfUpdatedAt DateTime?

  // Alt-mode (alt-Penny) identity documents — separate from both PA and Lila
  altAboutUser          String?
  altAboutUserUpdatedAt DateTime?
  altAboutSelf          String?
  altAboutSelfUpdatedAt DateTime?

  // Focus Lock — Penny's device-locking system
  focusLocked         Boolean   @default(false)
  focusProfile        String?   // the StayFocused profile name
  focusLockedAt       DateTime?
  focusReleaseType    String?   // "timed" | "optional"
  focusUnlocksAt      DateTime? // null for optional-release locks
  focusEmergencyCount Int       @default(0)
  focusProfiles       String?   // Penny-maintained list: one "name: description" per line

  memories          Memory[]
  conversations     Conversation[]
  tasks             Task[]
  nextSessionNotes  NextSessionNote[]
  clients           Client[]
  scheduledMessages ScheduledMessage[]
  domainReports     DomainReport[]
  weeklyBriefs      WeeklyBrief[]
  scheduledTasks    ScheduledTask[]
}

model Client {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  name              String
  contactName       String?
  contactSecondary  String?
  phone             String?
  email             String?
  businessStructure String?
  // status: prospect | onboarding | active | inactive | former
  status            String  @default("prospect")
  services          String? // comma-separated: "bookkeeping, payroll, tax_prep"
  grossRevenue      Float?
  billingStatus     String?
  notes             String?

  tasks Task[]
}

model Memory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  category       String
  content        String
  importance     Int      @default(5)
  archived       Boolean  @default(false)
  lastReferenced DateTime?
  domain         String?  // which modality domain owns this memory (null = global/identity)
  altModeScope   String?  // if set, only visible when in alt-mode for this modality id
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  type           String
  closed         Boolean  @default(false)
  activeModality String   @default("pa")
  isAltMode      Boolean  @default(false)
  messages       Message[]
}

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  role    String
  content String
}

model Task {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])

  title       String
  description String?
  dueDate     DateTime?
  priority    Int      @default(5)
  // status: pending | in_progress | done | deferred
  status      String   @default("pending")
  category    String?
  pennyNotes  String?
  domain      String?  // which modality domain owns this task (bookkeeping, household, etc.)
  onMasterList Boolean @default(false) // elevated to the PA's master list
  timing      String?  // immediate | medium | longterm  (used by June / household)
  lastReviewed DateTime? // when this item was last looked at
}

model NextSessionNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  content  String
  resolved Boolean @default(false)
  source   String? // which modality wrote this note
  target   String? // which modality it's addressed to (e.g. "pa" for notes up)
}

model ModalityState {
  id        String   @id @default(cuid())
  profileId String

  modalityId     String
  lastActiveAt   DateTime?  // last time this modality was active in a turn
  lastCompletedAt DateTime? // last time it ran a Shift/Session Complete

  @@unique([profileId, modalityId])
}

// Weekly domain assessment filed by each sub-modality (Margot, June, Iris, Sage, Vera).
// One row per modality per week. The cron endpoint writes these; Penny reads them.
model DomainReport {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id])

  modalityId String   // e.g. 'bookkeeping', 'household', 'creative', 'friend', 'political'
  adjective  String?  // headline word / phrase extracted from the first line of reportText
  reportText String   // full assessment response from the modality
  weekOf     DateTime // timestamp of the cron run that generated this report
}

// Penny's synthesis of all domain reports for a given week.
// One row per weekly cron run. Included in Penny's context so she can brief Adam.
// A future check-in Penny schedules for herself. At the scheduled time, the
// nightly cron builds her full context and asks her to compose a fresh Pushover
// notification — so the message reflects what's actually happened by then.
model ScheduledTask {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id])
  topic     String    // Penny's note to her future self: what to assess and why
  runAt     DateTime  // when to execute (stored as UTC)
  ran       Boolean   @default(false)
  ranAt     DateTime?
}

model WeeklyBrief {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  briefText String   // Penny's synthesised summary (her private notes)
  weekOf    DateTime
  flagged   Boolean  @default(false) // true if at least one domain needs Adam's attention
}

model ScheduledMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  message   String
  sendAt    DateTime
  sent      Boolean  @default(false)
  sentAt    DateTime?
  label     String?  // optional label so Penny can reference it, e.g. "morning briefing"
}
