generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userName       String?
  intakeComplete Boolean @default(false)

  memories          Memory[]
  conversations     Conversation[]
  tasks             Task[]
  nextSessionNotes  NextSessionNote[]
  clients           Client[]
  scheduledMessages ScheduledMessage[]
}

model Client {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  name              String
  contactName       String?
  contactSecondary  String?
  phone             String?
  email             String?
  businessStructure String?
  // status: prospect | onboarding | active | inactive | former
  status            String  @default("prospect")
  services          String? // comma-separated: "bookkeeping, payroll, tax_prep"
  grossRevenue      Float?
  billingStatus     String?
  notes             String?

  tasks Task[]
}

model Memory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  category       String
  content        String
  importance     Int      @default(5)
  archived       Boolean  @default(false)
  lastReferenced DateTime?
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  type     String
  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  role    String
  content String
}

model Task {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])

  title       String
  description String?
  dueDate     DateTime?
  priority    Int      @default(5)
  // status: pending | in_progress | done | deferred
  status      String   @default("pending")
  category    String?
  pennyNotes  String?
}

model NextSessionNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  content  String
  resolved Boolean @default(false)
}

model ScheduledMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  message   String
  sendAt    DateTime
  sent      Boolean  @default(false)
  sentAt    DateTime?
  label     String?  // optional label so Penny can reference it, e.g. "morning briefing"
}
