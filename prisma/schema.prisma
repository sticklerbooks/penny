generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userName       String?
  intakeComplete Boolean @default(false)

  // Cached Haiku-summarized snapshot of email + calendar (refreshed every 30 min)
  emailCalendarSummary  String?
  emailCalendarCachedAt DateTime?

  // Living documents — full overwrites, updated at least weekly by Penny
  aboutUser          String?
  aboutUserUpdatedAt DateTime?
  aboutSelf          String?
  aboutSelfUpdatedAt DateTime?

  memories          Memory[]
  conversations     Conversation[]
  tasks             Task[]
  nextSessionNotes  NextSessionNote[]
  clients           Client[]
  scheduledMessages ScheduledMessage[]
}

model Client {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  name              String
  contactName       String?
  contactSecondary  String?
  phone             String?
  email             String?
  businessStructure String?
  // status: prospect | onboarding | active | inactive | former
  status            String  @default("prospect")
  services          String? // comma-separated: "bookkeeping, payroll, tax_prep"
  grossRevenue      Float?
  billingStatus     String?
  notes             String?

  tasks Task[]
}

model Memory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  category       String
  content        String
  importance     Int      @default(5)
  archived       Boolean  @default(false)
  lastReferenced DateTime?
  domain         String?  // which modality domain owns this memory (null = global/identity)
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  type           String
  closed         Boolean  @default(false)
  activeModality String   @default("pa")
  messages       Message[]
}

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  role    String
  content String
}

model Task {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])

  title       String
  description String?
  dueDate     DateTime?
  priority    Int      @default(5)
  // status: pending | in_progress | done | deferred
  status      String   @default("pending")
  category    String?
  pennyNotes  String?
  domain      String?  // which modality domain owns this task (bookkeeping, household, etc.)
  onMasterList Boolean @default(false) // elevated to the PA's master list
}

model NextSessionNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  content  String
  resolved Boolean @default(false)
  source   String? // which modality wrote this note
  target   String? // which modality it's addressed to (e.g. "pa" for notes up)
}

model ModalityState {
  id        String   @id @default(cuid())
  profileId String

  modalityId     String
  lastActiveAt   DateTime?  // last time this modality was active in a turn
  lastCompletedAt DateTime? // last time it ran a Shift/Session Complete

  @@unique([profileId, modalityId])
}

model ScheduledMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  message   String
  sendAt    DateTime
  sent      Boolean  @default(false)
  sentAt    DateTime?
  label     String?  // optional label so Penny can reference it, e.g. "morning briefing"
}
